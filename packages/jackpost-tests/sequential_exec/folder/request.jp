meta {
  name: request
  type: http
  seq: 1
}

get {
  url: https://www.example.com
  body: none
  auth: none
}

script:pre-request {
  console.log("request pre");
}

script:post-response {
  {
    console.log("request post");
    const sequence = jp.getVar('sequence') || [];
    sequence.push(3);
    jp.setVar('sequence', sequence);
    
    console.log("sequence", jp.getVar('sequence'));
  }
}

tests {
  test("sequential script execution is proper", function() {
    const sequence = jp.getVar('sequence');
    jp.setVar('sequence', null);
    expect(sequence.toString()).to.equal([1,2,3].toString());
  });
}
