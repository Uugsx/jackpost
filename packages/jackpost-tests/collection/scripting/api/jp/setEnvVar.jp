meta {
  name: setEnvVar
  type: http
  seq: 3
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}


script:post-response {
  jp.setEnvVar("testSetEnvVar", "jackpost-29653")
}

tests {
  test("should set env var in scripts", function() {
    const testSetEnvVar = jp.getEnvVar("testSetEnvVar")
    expect(testSetEnvVar).to.equal("jackpost-29653");
  });
}