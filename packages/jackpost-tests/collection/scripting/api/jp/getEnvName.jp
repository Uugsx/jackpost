meta {
  name: getEnvName
  type: http
  seq: 1
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

script:pre-request {
  const envName = jp.getEnvName();
  jp.setVar("testEnvName", envName);
}

tests {
  test("should get env name in scripts", function() {
    const testEnvName = jp.getVar("testEnvName");
    expect(testEnvName).to.equal("Prod");
  });
}
