meta {
  name: deleteAllEnvVars
  type: http
  seq: 23
}

get {
  url: {{host}}/ping
  body: none
  auth: none
}

script:pre-request {
  jp.setEnvVar("testDelAllEnvVar", "to-be-deleted");
}

tests {
  const savedEnvVars = jp.getAllEnvVars();
  jp.deleteAllEnvVars();

  test("should delete all env vars", function() {
    const val = jp.getEnvVar("testDelAllEnvVar");
    expect(val).to.be.undefined;
  });

  test("should preserve env name after deleting all vars", function() {
    const envName = jp.getEnvName();
    expect(envName).to.equal("Prod");
  });

  test("should not throw when called on empty scope", function() {
    expect(function() {
      jp.deleteAllEnvVars();
    }).to.not.throw();
  });

  // Restore env vars for subsequent requests
  for (const [key, value] of Object.entries(savedEnvVars)) {
    jp.setEnvVar(key, value);
  }
}
