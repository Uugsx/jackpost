meta {
  name: set-var-dynamic-variable
  type: http
  seq: 1
}

post {
  url:  https://echo.usejackpost.com
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  jp.setVar("title", "{{$randomFirstName}}");
}

body:json {
  {
    "title": "{{title}}"
  }
}
